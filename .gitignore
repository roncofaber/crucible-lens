# Claude Code
# Shared agent config (.claude/settings.json, skills/, hooks/) is tracked on purpose.
# Only the personal layer is ignored: settings.local.json accumulates absolute home
# paths from per-command approvals, and worktrees/ is scratch.
claude_resume.sh
.claude/settings.local.json
.claude/worktrees/
docs/superpowers/

# Gradle
.gradle/
build/
*.ap_

# Local configuration (machine-specific, never commit)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.kotlin_module
.navigation/
captures/
vcs.xml

# macOS
.DS_Store

# Kotlin build metadata
.kotlin/

# Native builds
.externalNativeBuild/
.cxx/

# Compiled outputs
*.apk
*.aab
*.dex
*.class
/out/
/bin/
/gen/
# Anchored: an unanchored `release/` also matches any nested directory of that name
# (it silently excluded .claude/skills/release/). Gradle's own release outputs live
# under build/, which is already ignored above.
/release/

# Keystore files (sensitive – keep out of VCS)
*.jks
*.keystore

# Logs and profiling
*.log
*.hprof

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint-report.html
lint-report_files/
lint-results.xml

# Merge artifacts
*.orig

# iOS – auto-generated by XcodeGen from project.yml
iosApp/*.xcodeproj/
iosApp/*.xcworkspace/
iosApp/xcuserdata/
